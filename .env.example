# Copie para .env e ajuste conforme necessário.
# Dev local (docker compose postgres): use localhost
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interview_agent

# Testes pytest usam interview_agent_test (ver tests/conftest.py)
# DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interview_agent_test

GROQ_API_KEY=
OPENROUTER_API_KEY=

# Opcional — default 86400 (24h)
# AUTH_TOKEN_TTL_SECONDS=86400

# Opcional — default INFO (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Qdrant (default localhost:6333 — use vector-db when running inside Docker Compose)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=   # obrigatório no Qdrant Cloud (Render/produção)

# CORS — origens permitidas (comma-separated). Dev default: Vite em localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Em produção, defina a URL do frontend (ex.: https://app.example.com)
